# Copy this file to secrets.yaml (in the same esphome/ folder) and fill in
# your own values. secrets.yaml is gitignored — never commit the real one.
# If you already have a secrets.yaml for other ESPHome nodes (e.g. in the
# ESPHome add-on), just add the two battery_guard_* keys to it.

# Your Battery Guard's MAC: the 12-character serial printed on the device,
# with colons added (A1B2C3D4E5F6 -> A1:B2:C3:D4:E5:F6)
bm6_mac: "A1:B2:C3:D4:E5:F6"

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# 32-byte base64 key for the ESPHome native API's encryption. The ESPHome
# dashboard's "New Device" wizard generates one for you, or:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
battery_guard_api_key: "REPLACE_WITH_BASE64_KEY"

# Password for OTA firmware updates
battery_guard_ota_password: "REPLACE_WITH_OTA_PASSWORD"
